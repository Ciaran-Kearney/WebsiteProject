      `,
      tags: ["Automation", "Pharma", "Vision Inspections", "Label Application"],
      image: `/assets/images/projects/viatris.jpg`,
      video: "https://www.youtube.com/embed/28G7U99cC4c"
    }
    ,
    pia: {
      title: "Print, Inspect, Apply System",
      description: "Integrated print, inspection and apply system for packaging lines.",
      details: `<p>Placeholder project for a print-inspect-apply solution.</p>`,
      tags: ["Automation", "Label Application", "Inspection"],
      image: `/assets/images/projects/ProjectEng.jpg`
    },
    square_bottle: {
      title: "Square Bottle Labeller",
      description: "High-speed labelling solution for square bottle formats.",
      details: `<p>Placeholder project for square bottle labelling.</p>`,
      tags: ["Automation", "Label Application"],
      image: `/assets/images/projects/ProjectEng.jpg`
    },
    vial_labeller: {
      title: "Vial Labeller",
      description: "Vial labelling and inspection line integration.",
      details: `<p>Placeholder project for vial labelling line.</p>`,
