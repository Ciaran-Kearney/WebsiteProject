      image: `/assets/images/projects/ProjectEng.jpg`
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const projectCards = document.querySelectorAll('.project-card');
    const modal = document.getElementById('projectModal');
    const modalContent = modal.querySelector('.modal-content');
    const modalTitle = modal.querySelector('.modal-title');
    const modalTags = modal.querySelector('.modal-tags');
    const modalDescription = modal.querySelector('.modal-description');
    const modalDetails = modal.querySelector('.modal-details');
    const modalImage = modal.querySelector('.modal-image');
    const closeBtn = modal.querySelector('.modal-close');
    const modalOverlay = modal.querySelector('.modal-overlay');

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    projectCards.forEach(card => {
      const viewButton = card.querySelector('.view-project-btn');
      viewButton.addEventListener('click', (e) => {
        e.stopPropagation();
        const projectId = card.dataset.project;
        const data = projectData[projectId];

        modalTitle.textContent = data.title;
        
        // Clear existing tags
        while (modalTags.firstChild) {
          modalTags.removeChild(modalTags.firstChild);
        }
        
        // Add new tags safely
        data.tags.forEach(tag => {
          const tagSpan = document.createElement('span');
          tagSpan.className = 'tag';
          tagSpan.textContent = tag;
          modalTags.appendChild(tagSpan);
        });
        
        modalDescription.textContent = data.description;
        
        // Create details content safely
        const detailsContainer = document.createElement('div');
        detailsContainer.innerHTML = data.details; // This is still needed for formatted HTML content
        modalDetails.innerHTML = ''; // Clear existing content
        modalDetails.appendChild(detailsContainer);

        const modalMedia = modal.querySelector('.modal-media');
        if (data.video) {
          modalMedia.innerHTML = `<iframe width="100%" height="315" src="${data.video}" title="Stryker Demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        } else if (data.image) {
          modalMedia.innerHTML = `<img class="modal-image" src="${data.image}" alt="${data.title}" />`;
        } else {
          modalMedia.innerHTML = '';
        }

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modalOverlay.addEventListener('click', closeModal);
  });
</script>

