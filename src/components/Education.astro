---
// Education component
---

<section id="education" class="education-section">
  <div class="container">
    <h2 class="section-title">What I Have Studied</h2>
        <div class="timeline-container">
      <div class="timeline-line"></div>
      <div class="timeline-item">
        <div class="timeline-dot">2021</div>
        <div class="timeline-content">
          <h3>Bachelor of Engineering (Mechanical)</h3>
          <h4>NUI Galway, Galway, Ireland</h4>
          <p class="timeline-period">2016 - 2021</p>
          <ul class="timeline-achievements">
            <li>Second Class Honours</li>
          </ul>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot">2016</div>
        <div class="timeline-content">
          <h3>Leaving Certificate</h3>
          <h4>Patrician High School, Carrickmacross</h4>
          <p class="timeline-period">2007 - 2016</p>
          <ul class="timeline-achievements">
            <li>505 Points</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Make the education background slightly less dark so layout dots remain visible */
  .education-section {
    background: rgba(10,25,41,0.15);
    padding: 3rem 0;
    border-radius: 8px;
  }

  .timeline-item .timeline-dot {
    background: rgba(0,180,216,0.08);
    color: var(--text-bright);
    padding: 6px 8px;
    border-radius: 6px;
  }
</style>

